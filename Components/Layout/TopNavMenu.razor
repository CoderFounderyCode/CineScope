@inject NavigationManager Nav

<nav class="navbar navbar-expand-md navStyle" data-bs-theme="dark">
    <div class="container-xxl">
        <a href="/" class="me-3">
            <img src="/images/devDotnetLogoCenter.png" height="40" />
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarControl" aria-expaned="false" aria-label="Toggle Navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <!--Menu Links-->
        <div class="navbar-collapse collapse" id="navbarContent">
            <ul class="navbar-nav mb-lg-0 mb-2 me-auto">
                <li class="nav-item">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                        <i class="bi bi-house text-success"></i>
                        <span>Home</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/nowplaying" Match="NavLinkMatch.All">
                        <i class="bi bi-film text-primary"></i>
                        <span>Now Playing</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/popular" Match="NavLinkMatch.All">
                        <i class="bi bi-stars text-warning"></i>
                        <span>Popular</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/favourites" Match="NavLinkMatch.All">
                        <i class="bi bi-heart-fill text-danger"></i>
                        <span>Favourites</span>
                    </NavLink>
                </li>
            </ul>
            <form class="d-flex" role="search">
                <i class="bi bi-search text-secondary me-2"></i>
                <InputText class="form-control form-control-sm me-2" type="search" placeholder="Search movies..." aria-label="Search" DisplayName="query" @bind-Value="Query" />
                <button class="btn btn-sm btn-primary" type="button" @onclick="HandleSearch">Search</button>
                <i class="bi bi-search"></i>
            </form>
            </div>
        </div>
    </nav>

@code {

    private string Query { get; set; } = string.Empty;

    private void HandleSearch()
    {
        // Navigate to a search results page with the query as a parameter
        // Take the Query value and pass it to the search page.

        Nav.NavigateTo(string.IsNullOrEmpty(Query) ? "/search" : $"/search?query={Query}");
       

    }
}

