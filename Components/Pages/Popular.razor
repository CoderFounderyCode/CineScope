@page "/popular"

@inject TMDBService TMDBService

<PageTitle>CineScope-Popular Movies</PageTitle>

<div class="container-xxl py-3">

    <h1>
        <i class="bi bi-film text-primary"></i>
        Popular
    </h1>
    <p class="lead italic">
        Movies that are currently popular with TMDB users. This section provides information about the most popular movies based on user ratings, reviews, and overall engagement. Whether you're looking for the latest blockbusters, critically acclaimed films, or hidden gems, you'll find the most popular movies here to help you decide what to watch next.
    </p>

       

        @if (popularMovies is null)
        {
            <div class="d-flex justify-content-center align-items-center">
                @if (isLoading)
                {
                    <h2 class="text-muted">Loading popular movies...</h2>
                }
                else
                {
                    <h2 class="text-muted">
                        Failed to load popular movies
                    </h2>
                }
            </div>
        }
        else
        {
        <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4">

            @foreach (var movie in popularMovies.Results)
            {
                <div class="col">
                    <MovieCard Movie="movie" />
                </div>
            }
            </div>
        }
    </div>


@code {

    MovieListResponse? popularMovies;
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            popularMovies = await TMDBService.GetPopularMoviesAsync();

        }
        catch(Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }

    }

}