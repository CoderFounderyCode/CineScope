@page "/favourites"
@inject FavouritesService FavouritesService
@implements IDisposable

<PageTitle>CineScope-Favourite Movies</PageTitle>

<div class="container-xxl py-3">

    <h1>
        <i class="bi bi-film text-primary"></i>
        Favourite Movies
    </h1>
    <p class="lead italic">
        Movies that you have marked as favourites. This section provides a personalized collection of movies that you have added to your favourites list. Whether you're looking for movies you've enjoyed in the past or want to keep track of films you want to watch later, you'll find all your favourite movies here in one convenient place.
    </p>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center">
            <h2 class="text-muted">Loading favourite movies...</h2>
        </div>
    }
    else if (!favouriteMovies.Any())
    {
        <h2 class="text-muted">No favourite movies yet.</h2>
    }
    else
    {
        <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4">
            @foreach (var movie in favouriteMovies)
            {
                <div class="col">
                    <MovieCard Movie="movie" />
                </div>
            }
        </div>
    }
</div>

@code
{
    List<Movie> favouriteMovies = [];
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        FavouritesService.OnFavouritesChanged += OnFavouritesChanged;
        await LoadFavouritesAsync();
    }

    private async Task LoadFavouritesAsync()
    {
        try
        {
            isLoading = true;
            favouriteMovies = await FavouritesService.GetFavouritesAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading favourite movies: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnFavouritesChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadFavouritesAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        FavouritesService.OnFavouritesChanged -= OnFavouritesChanged;
    }
}
