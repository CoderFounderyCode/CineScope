@* 
    Route uses kebab-case (/movie-details) which is the web standard for URLs.
    C# class name remains PascalCase (MovieDetails) — each convention used in its correct context.
*@
@page "/movie-details/{MovieId:int}"
@inject TMDBService TMDBService
@inject IJSRuntime JS

@if (movieDetail is not null)
{
    <PageTitle>@movieDetail.Title</PageTitle>
}
else
{
    <PageTitle>Movie Detail-not found</PageTitle>
}

<div class="container-fluid p-0">
    @if (movieDetail is null)
    {
        <div class="justify-content-center align-items-center py-5">
            @if (isLoading)
            {
                <h2 class="text-muted">
                    Loading movie detail
                </h2>
            }
            else
            {
                <h2 class="text-muted">
                    The requested movie detail could not be found.
                </h2>
            }
                 
        </div>
    }
    else
    {
        <div id="movie-details" style="--background: url(@movieDetail.BackdropPath)">
            <div id="movie-wrapper">
                <div class="container-xxl py-3">
                    <div class="row">
                        <div class="col-12 col-md-4 col-xl-3 text-md-start mb-3 text-center">
                            <img class="img-fluid" id="movie-poster" alt="movie poster" src="@movieDetail.PosterPath" />
                        </div>
                        <div class="col-12 col-md-8 col-xl-9">
                            <h3 class="display-6 fw-bold mb-0">@movieDetail.Title</h3>
                            <div class="lead mb-3">
                                @movieDetail.Tagline
                            </div>
                            <div class="hstack gap-2">
                                @{
                                    bool dateParsed = DateTime.TryParse(movieDetail.ReleaseDate, out DateTime releaseDate);
                                }
                                @if (dateParsed)
                                {
                                    <span>
                                        @releaseDate.ToString("dd MMMM, yyyy") |
                                        
                                    </span>
                                }
                                <span>
                                    @{
                                        int hours = movieDetail.Runtime / 60;
                                        int minutes = movieDetail.Runtime % 60;
                                    }
                                    @hours hour(s) @minutes minutes
                                </span>

                                      
                            </div>
                            <div class="hstack my-2 gap-2">
                                @foreach (var genre in movieDetail.Genres)
                                {
                                    <span class="badge text-bg-primary">@genre.Name </span>
                                }

                            </div>
                            <h5 class="lead fw-bold pt-3">Overview</h5>
                            <p>@movieDetail.Overview</p>
                            <div class="">
                                <span>
                                    Viewer rating: @((movieDetail.VoteAverage * 10).ToString("F1"))%
                                </span>

                            </div>
                            @if (!string.IsNullOrEmpty(movieTrailer?.Key))
                            {
                                <div id="btn-trailer" class="mt-3">
                                    <button class="btn btn-outline-warning"
                                            data-bs-toggle="modal"
                                            data-bs-target="#movie-modal">
                                        <i class="bi bi-play"></i>Play Trailer
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    
</div>

<div class="modal" tabindex="-1" id="movie-modal">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content modal-background">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title">@(movieDetail?.Title ?? "Movie Trailer")</h5>
                <button type="button" data-bs-dismiss="modal" aria-label="Close" class="ms-auto">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="ratio ratio-16x9">
                    <iframe id="modal-trailer" src="" allowfullscreen></iframe>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-warning ms-auto" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter]
    public int MovieId { get; set; }

    bool isLoading = true;

    // The fully qualified namespace is required here because this component is also named
    // 'MovieDetails', which causes an ambiguity. Without it, the compiler resolves
    // 'MovieDetails' to this component class rather than the intended model class.
    private CineScope.Models.MovieDetails? movieDetail;
    private Video? movieTrailer;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            movieDetail = await TMDBService.GetMovieDetailsAsync(MovieId);
            movieTrailer = await TMDBService.GetMovieTrailersAsync(MovieId);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error fetching movie details for MovieId {MovieId}: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        // Set up event listener for the modal to load the trailer when opened
        await using var jsmodule = await JS.InvokeAsync<IJSObjectReference>("import", "/Components/pages/MovieDetails.razor.js");

        if(movieTrailer is not null)
        {
            string trailerUrl = $"https://www.youtube.com/embed/{movieTrailer.Key}";
            await jsmodule.InvokeVoidAsync("initVideoPlayer", trailerUrl);
        }
        else
        {
            await jsmodule.InvokeVoidAsync("initVideoPlayer", "");  
        }
    }
}