@page "/search"
@using Microsoft.AspNetCore.Components
@inject TMDBService TMDBService

<div class="container-xxl py-3">

    <h1>
        <i class="bi bi-search text-primary"></i>
        Search Results :
    </h1>
    <p class="lead italic">
        Movies matching the search query "@Query".
    </p>

       

    @if (searchResults is null)
    {
        <div class="d-flex justify-content-center align-items-center">
            @if (string.IsNullOrWhiteSpace(Query))
            {
                <h2 class="text-muted">Please enter a search query using the box at the top right.</h2>
            }
            else if (isLoading)
            {
                <h2 class="text-muted">Loading search results...</h2>
            }
            else
            {
                <h2 class="text-muted">
                    Failed to load search results
                </h2>
            }
        </div>
    }
    else
    {
        @if (searchResults.Results.Count == 0)
        {
            <div class="d-flex justify-content-center align-items-center">
                <h2 class="text-muted">No movies found matching the search query "@Query".</h2>
            </div>
        }
        else
        {

            <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4">

                @foreach (var movie in searchResults.Results)
                {
                    <div class="col">
                        <MovieCard Movie="movie" />
                    </div>
                }
            </div>
        }
    }

</div>

@code {

    [SupplyParameterFromQuery]
    private string Query { get; set; } = string.Empty;

    private bool isLoading = true;
    private MovieListResponse? searchResults;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Query))
            {
                searchResults = null;
            }
            else
            {
                isLoading = true;
                searchResults = await TMDBService.SearchMoviesAsync(Query);

            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error searching movies: {ex.Message}");
            searchResults = null;
        }
        finally
        {
            isLoading = false;
        }
    }

}
