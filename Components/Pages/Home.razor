@page "/"
@layout HomeLayout
<PageTitle>Home</PageTitle>
<!-- Page Background -->
<div class="h-100 d-flex justify-content-center">
    <div class="row row-cols-1 row-cols-xl-2 container-xxl h-100">
        <div class="col d-flex flex-column justify-content-xl-center order-xl-first order-last">
            <div class="title">CineScope: A Code example using an API</div>
            <div class="subtitle py-3">
                Now Playing is an app using data provided by
                <a href="https://www.themoviedb.org/" class="link-warning">The Movie DB</a> API.
                This app allows you to browse movies that are now playing in theatres,
                movies that are currently popular with TMDB users, save a list of your
                favorite movies, or search for movies by title.
            </div>
            <div class="mt-3">
                <h3>Try it out now.</h3>
                <div class="hstack gap-2">
                    <a href="nowplaying" class="btn btn-CineScopeCta">CineScope</a>                  
                </div>
            </div>
            <div class="mt-3">
                Built using:
                <div class="hstack my-2">
                    <div title="C#"><i class="devicons devicon-csharp-plain colored me-1"></i></div>
                    <div title="Blazor"><i class="devicons devicon-blazor-original colored me-1"></i></div>
                    <div title="Bootstrap"><i class="devicons devicon-bootstrap-plain colored me-1"></i></div>
                    <div title="JavaScript"><i class="devicons devicon-javascript-plain colored me-1"></i></div>
                    <div title="HTML5"><i class="devicons devicon-html5-plain colored me-1"></i></div>
                    <div title="CSS3"><i class="devicons devicon-css3-plain colored me-1"></i></div>
                </div>
            </div>
        </div>
        <div class="col d-flex flex-column justify-content-center">
            <img src="/images/mw1920_LandingPage800.png" class="img-fluid" />
        </div>
    </div>
</div>