@page "/nowplaying"

@inject TMDBService TMDBService

<PageTitle>CineScope-Now Playing</PageTitle>


<div class="container-xxl py-3">

    <h1>
        <i class="bi bi-film text-primary"></i>
        Now Playing
    </h1>
    <p class="lead italic">
        Movies that are currently playing in theaters. This section provides information about the latest releases and what's currently showing on the big screen. Whether you're looking for action, comedy, drama, or any other genre, you'll find the latest movies here to help you decide what to watch next.
    </p>

       

        @if (nowPlayingMovies is null)
        {
            <div class="d-flex justify-content-center align-items-center">
                @if (isLoading)
                {
                    <h2 class="text-muted">Loading now playing movies...</h2>
                }
                else
                {
                    <h2 class="text-muted">
                        Failed to load now playing movies
                    </h2>
                }
            </div>
        }
        else
        {
        <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4">

            @foreach (var movie in nowPlayingMovies.Results)
            {
                <div class="col">
                    <MovieCard Movie="movie" />
                </div>
            }
            </div>

        }
    </div>


@code {
    private MovieListResponse? nowPlayingMovies;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            nowPlayingMovies = await TMDBService.GetNowPlayingMovies();

        }
        catch(Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }

    }

}
